{
  "schemaVersion": 1,
  "id": "corpes",
  "version": "${version}",
  "name": "Corpes",
  "description": "Server-side corpses. Your items stay with your body when you die. Players don't need to install anything.",
  "authors": ["cornybirdy"],
  "contact": {
    "sources": "https://github.com/CornyBirdy/Paper-Corpes"
  },
  "environment": "*",
  "entrypoints": {
    "main": ["dev.cornybirdy.corpes.Corpes"]
  },
  "mixins": ["corpes.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
